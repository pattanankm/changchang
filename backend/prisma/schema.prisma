generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // หรือ mysql ตามที่ทีมเลือก
  url      = env("DATABASE_URL")
}

// ================= Enums =================
enum BookingSourceEnum {
  WEBSITE
  AGENCY
  LINE
  WALK_IN
  OTA
}

enum BookingStatusEnum {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatusEnum {
  PENDING
  PAID
  FAILED
}

enum CommissionStatusEnum {
  PENDING
  PAID
}

enum PaymentMethodEnum {
  CASH
  BANK_TRANSFER
}

// ================= Models =================

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @db.VarChar(50)
  
  users     User[]

  @@map("roles")
}

model User {
  user_id       BigInt   @id @default(autoincrement())
  role_id       Int
  phone_number  String?  @db.VarChar(20)
  password_hash String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  role          Role          @relation(fields: [role_id], references: [role_id])
  driver_detail DriverDetail?

  // ความสัมพันธ์กับ Bookings (แยก 3 บทบาท)
  bookings_as_customer Booking[]    @relation("CustomerBookings")
  bookings_created     Booking[]    @relation("CreatedBookings")
  bookings_as_driver   Booking[]    @relation("DriverBookings")

  commissions          Commission[]

  @@map("users")
}

model DriverDetail {
  user_id       BigInt @id
  full_name     String @db.VarChar(255)
  license_plate String @db.VarChar(20)

  user          User   @relation(fields: [user_id], references: [user_id])

  @@map("driver_details")
}

model Activity {
  activity_id   BigInt   @id @default(autoincrement())
  activity_name String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  price_adult   Decimal  @db.Decimal(10, 2)
  price_child   Decimal  @db.Decimal(10, 2)
  session_type  String   @db.VarChar(50)
  is_active     Boolean  @default(true)

  bookings      Booking[]

  @@map("activities")
}

model Booking {
  booking_id     BigInt            @id @default(autoincrement())
  customer_id    BigInt?
  created_by     BigInt?
  driver_id      BigInt?
  activity_id    BigInt
  booking_source BookingSourceEnum
  booking_status BookingStatusEnum
  payment_status PaymentStatusEnum
  head_count     Int
  total_amount   Decimal           @db.Decimal(10, 2)
  booking_date   DateTime
  created_at     DateTime          @default(now())

  // ความสัมพันธ์
  customer       User?             @relation("CustomerBookings", fields: [customer_id], references: [user_id])
  creator        User?             @relation("CreatedBookings", fields: [created_by], references: [user_id])
  driver         User?             @relation("DriverBookings", fields: [driver_id], references: [user_id])
  activity       Activity          @relation(fields: [activity_id], references: [activity_id])
  
  commissions    Commission[]

  @@map("bookings")
}

model Commission {
  commission_id   BigInt               @id @default(autoincrement())
  booking_id      BigInt
  driver_id       BigInt
  head_count      Int
  commission_rate Decimal              @db.Decimal(10, 2)
  total_amount    Decimal              @db.Decimal(10, 2)
  payment_status  CommissionStatusEnum
  payment_method  PaymentMethodEnum?
  paid_at         DateTime?

  // ความสัมพันธ์
  booking         Booking              @relation(fields: [booking_id], references: [booking_id])
  driver          User                 @relation(fields: [driver_id], references: [user_id])

  @@map("commissions")
}